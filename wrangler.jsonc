{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yupay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yupay"
      // Sin database_id: Wrangler crea y vincula la base automáticamente
      // la primera vez que se despliega. No necesitas commitear el UUID.
      // Si la creas a mano en el panel, agrega aquí:
      // "database_id": "PEGA-AQUI-EL-DATABASE-ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
